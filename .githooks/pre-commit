#!/bin/sh
# 提交前密钥扫描（2026-11-10 凭据泄露事件后新增）
# 启用方式：git config core.hooksPath .githooks
# 绕过方式：git commit --no-verify（不推荐）

if command -v python >/dev/null 2>&1; then
    PY=python
elif [ -x .venv/Scripts/python.exe ]; then
    PY=.venv/Scripts/python.exe
elif [ -x .venv/bin/python ]; then
    PY=.venv/bin/python
else
    echo "[pre-commit] 未找到 python，跳过密钥扫描" >&2
    exit 0
fi

"$PY" scripts/check_secrets.py --staged
status=$?
if [ "$status" -ne 0 ]; then
    echo "" >&2
    echo "[pre-commit] 提交已被阻止：疑似密钥。确认无风险后可用 git commit --no-verify 跳过。" >&2
fi
exit $status
