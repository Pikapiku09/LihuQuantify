# Tushare Pro API Token
# 方式1：直接填 token
# 方式2：指向 token 文件（支持 MCP JSON 格式或纯文本）
LIHU_TUSHARE_TOKEN=
LIHU_TUSHARE_TOKEN_FILE=E:/LihuQuantify/tushareMcp.json

# DuckDB 数据库路径
LIHU_DUCKDB_PATH=./data/lihu_quant.duckdb

# 缓存目录（Tushare 接口响应缓存）
LIHU_CACHE_DIR=./data/cache

# MiniQMT 配置（默认禁用，仅模拟）
LIHU_QMT_ENABLED=false
LIHU_QMT_PATH=C:/国金QMT/bin.x64
LIHU_QMT_ACCOUNT=

# 初始资金（模拟盘）
LIHU_INIT_CAPITAL=100000

# ===== 第四轮（部署与运维）新增 =====

# 邮件告警授权码（QQ/163 邮箱"授权码"，非登录密码；settings.yaml 其余邮件项留空走 yaml）
LIHU_ALERT__EMAIL__AUTH_CODE=

# healthchecks.io 心跳（缺席告警；空=不 ping。后台设"每日 17:30 前未收到成功 ping → 告警"）
LIHU_HEARTBEAT__HEALTHCHECKS_URL=

# 看板监听（本机默认 127.0.0.1；Docker 容器内须 0.0.0.0，compose 已设）
LIHU_WEB_HOST=127.0.0.1
LIHU_WEB_PORT=8000

# ===== 第十一轮 P0-7 新增 =====
# 看板 API 鉴权令牌（Bearer）：非空时所有 /api/* 需带 Authorization 头；
# 空 = 不启用（本机 127.0.0.1 直跑零配置不变）。局域网/公网暴露时必填。
# 前端首次访问 401 会弹输入框，输入一次存 localStorage。
LIHU_WEB_TOKEN=

# ===== 第八轮（AI 收盘总结）新增 =====
# LLM 总结接口密钥（OpenAI 兼容；仅用于日报展示，不参与任何交易决策）
# 填好后把 config/settings.yaml 的 ai_summary.enabled 改为 true
LIHU_AI_SUMMARY__API_KEY=
